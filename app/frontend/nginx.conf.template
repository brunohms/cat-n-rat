# Rendered at container start by the nginx image (envsubst replaces ${BACKEND_URL})
server {
    listen 8080;
    root /usr/share/nginx/html;

    # Same path as the Vite dev proxy: /api/purchases -> ${BACKEND_URL}/purchases
    location /api/ {
        proxy_pass ${BACKEND_URL}/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Built files have a content hash in their names, so they can be cached forever
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
